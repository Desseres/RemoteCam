@@ -0,0 +1,18 @@
+package rtsp
+
+import (
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestDesktopSequenceGuard(t *testing.T) {
+	var delivered []uint16
+	closed := 0
+	write := stopOnSequenceGap(func(p *rtp.Packet) { delivered = append(delivered, p.SequenceNumber) }, func() { closed++ })
+	for _, seq := range []uint16{65535, 0, 1, 3, 4, 5} {
+		write(&rtp.Packet{Header: rtp.Header{SequenceNumber: seq}})
+	}
+	require.Equal(t, []uint16{65535, 0, 1}, delivered)
+	require.Equal(t, 1, closed)
+}
