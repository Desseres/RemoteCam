diff --git a/pkg/webrtc/nack_test.go b/pkg/webrtc/nack_test.go
new file mode 100644
index 0000000..bf35507
--- /dev/null
+++ b/pkg/webrtc/nack_test.go
@@ -0,0 +1,95 @@
+package webrtc
+
+import (
+	"testing"
+	"time"
+
+	"github.com/pion/rtcp"
+	"github.com/pion/rtp"
+	pion "github.com/pion/webrtc/v4"
+	"github.com/stretchr/testify/require"
+)
+
+// Exercise the actual connection lifecycle and Pion NACK responder over local ICE.
+// The test receiver accepts a duplicate only so we can verify a requested repair
+// without relying on random packet loss. Production replay protection is unchanged.
+func TestConnectionRetransmitsNack(t *testing.T) {
+	api, err := NewServerAPI("", "", &Filters{Loopback: true, Networks: []string{"udp4"}})
+	require.NoError(t, err)
+	pc, err := api.NewPeerConnection(pion.Configuration{})
+	require.NoError(t, err)
+	conn := NewConn(pc)
+	t.Cleanup(func() { _ = conn.Close() })
+
+	settings := pion.SettingEngine{}
+	settings.SetIncludeLoopbackCandidate(true)
+	settings.SetNetworkTypes([]pion.NetworkType{pion.NetworkTypeUDP4})
+	settings.DisableSRTPReplayProtection(true)
+	remoteAPI := pion.NewAPI(pion.WithSettingEngine(settings))
+	remote, err := remoteAPI.NewPeerConnection(pion.Configuration{})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = remote.Close() })
+
+	packets := make(chan *rtp.Packet, 8)
+	remote.OnTrack(func(track *pion.TrackRemote, _ *pion.RTPReceiver) {
+		for {
+			packet, _, readErr := track.ReadRTP()
+			if readErr != nil {
+				return
+			}
+			select {
+			case packets <- packet:
+			default:
+			}
+		}
+	})
+	track := NewTrack("video")
+	_, err = pc.AddTrack(track)
+	require.NoError(t, err)
+	_, err = pc.CreateDataChannel("test", nil)
+	require.NoError(t, err)
+
+	offer, err := pc.CreateOffer(nil)
+	require.NoError(t, err)
+	gathered := pion.GatheringCompletePromise(pc)
+	require.NoError(t, pc.SetLocalDescription(offer))
+	select {
+	case <-gathered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("offer ICE timeout")
+	}
+	require.NoError(t, remote.SetRemoteDescription(*pc.LocalDescription()))
+	answer, err := remote.CreateAnswer(nil)
+	require.NoError(t, err)
+	gathered = pion.GatheringCompletePromise(remote)
+	require.NoError(t, remote.SetLocalDescription(answer))
+	select {
+	case <-gathered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("answer ICE timeout")
+	}
+	require.NoError(t, pc.SetRemoteDescription(*remote.LocalDescription()))
+	require.Eventually(t, func() bool { return pc.ConnectionState() == pion.PeerConnectionStateConnected }, 5*time.Second, 10*time.Millisecond)
+
+	require.NoError(t, track.WriteRTP(96, &rtp.Packet{
+		Header: rtp.Header{Version: 2, Marker: true, Timestamp: 90000}, Payload: []byte{0x65, 0x88, 0x84},
+	}))
+	var original *rtp.Packet
+	select {
+	case original = <-packets:
+	case <-time.After(2 * time.Second):
+		t.Fatal("initial RTP missing")
+	}
+	require.NoError(t, remote.WriteRTCP([]rtcp.Packet{&rtcp.TransportLayerNack{
+		SenderSSRC: 1, MediaSSRC: original.SSRC,
+		Nacks: []rtcp.NackPair{{PacketID: original.SequenceNumber}},
+	}}))
+	select {
+	case repaired := <-packets:
+		require.Equal(t, original.SequenceNumber, repaired.SequenceNumber)
+		require.Equal(t, original.Timestamp, repaired.Timestamp)
+		require.Equal(t, original.Payload, repaired.Payload)
+	case <-time.After(2 * time.Second):
+		t.Fatal("go2rtc did not retransmit the packet requested by NACK")
+	}
+}
diff --git a/pkg/webrtc/repair_interceptors.go b/pkg/webrtc/repair_interceptors.go
new file mode 100644
index 0000000..d96b0b4
--- /dev/null
+++ b/pkg/webrtc/repair_interceptors.go
@@ -0,0 +1,41 @@
+package webrtc
+
+import (
+	"os"
+	"time"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/interceptor/pkg/nack"
+	"github.com/pion/webrtc/v4"
+)
+
+func registerRemoteCamInterceptors(m *webrtc.MediaEngine, i *interceptor.Registry) error {
+	if os.Getenv("REMOTECAM_RTP_REPAIR") != "1" {
+		return webrtc.RegisterDefaultInterceptors(m, i)
+	}
+	// At 40 Mb/s a single keyframe can exceed the default 512-packet history.
+	// Request repair promptly while retaining TWCC congestion feedback/reports.
+	g, err := nack.NewGeneratorInterceptor(nack.GeneratorSize(8192),
+		nack.GeneratorInterval(20*time.Millisecond), nack.GeneratorMaxNacksPerPacket(5))
+	if err != nil {
+		return err
+	}
+	r, err := nack.NewResponderInterceptor()
+	if err != nil {
+		return err
+	}
+	m.RegisterFeedback(webrtc.RTCPFeedback{Type: "nack"}, webrtc.RTPCodecTypeVideo)
+	m.RegisterFeedback(webrtc.RTCPFeedback{Type: "nack", Parameter: "pli"}, webrtc.RTPCodecTypeVideo)
+	i.Add(r)
+	i.Add(g)
+	if err = webrtc.ConfigureRTCPReports(i); err != nil {
+		return err
+	}
+	if err = webrtc.ConfigureSimulcastExtensionHeaders(m); err != nil {
+		return err
+	}
+	if err = webrtc.ConfigureStatsInterceptor(i); err != nil {
+		return err
+	}
+	return webrtc.ConfigureTWCCSender(m, i)
+}
diff --git a/pkg/webrtc/video_repair.go b/pkg/webrtc/video_repair.go
new file mode 100644
index 0000000..f80da37
--- /dev/null
+++ b/pkg/webrtc/video_repair.go
@@ -0,0 +1,209 @@
+package webrtc
+
+import (
+	"time"
+
+	"github.com/pion/rtp"
+)
+
+// videoRepair is confined to one OnTrack reader. It holds only incomplete or
+// reordered frames, not a fixed playback queue. Pion's NACK interceptor requests
+// retransmissions; this layer gives those packets time to arrive before RTSP.
+type videoRepair struct {
+	hevc                                      bool
+	emit                                      func(*rtp.Packet)
+	pli                                       func()
+	pending                                   map[uint16]*rtp.Packet
+	next                                      uint16
+	outNext                                   uint16
+	outStarted                                bool
+	started, boundary, needKey                bool
+	gap, lastPLI                              time.Time
+	frame                                     []*rtp.Packet
+	bytes                                     int
+	stamp                                     uint32
+	key                                       bool
+	Reordered, Late, Lost, Frames, Suppressed uint64
+}
+
+func newVideoRepair(hevc bool, emit func(*rtp.Packet), pli func()) *videoRepair {
+	return &videoRepair{hevc: hevc, emit: emit, pli: pli,
+		pending: make(map[uint16]*rtp.Packet), needKey: true}
+}
+
+func (v *videoRepair) requestKey(now time.Time) {
+	if v.needKey && (v.lastPLI.IsZero() || now.Sub(v.lastPLI) >= 500*time.Millisecond) {
+		v.lastPLI = now
+		v.pli()
+	}
+}
+
+func (v *videoRepair) damage() {
+	v.frame = nil
+	v.bytes = 0
+	v.key = false
+	v.needKey = true
+	v.boundary = false
+}
+
+func (v *videoRepair) Push(p *rtp.Packet, now time.Time) {
+	if !v.started {
+		v.next = p.SequenceNumber
+		v.started = true
+	}
+	distance := int16(p.SequenceNumber - v.next)
+	if distance < 0 {
+		v.Late++
+		return
+	}
+	if _, duplicate := v.pending[p.SequenceNumber]; duplicate {
+		v.Late++
+		return
+	}
+	if distance > 0 {
+		v.Reordered++
+	}
+	v.pending[p.SequenceNumber] = p
+	for len(v.pending) > 0 {
+		packet, ok := v.pending[v.next]
+		if !ok {
+			if v.gap.IsZero() {
+				v.gap = now
+			}
+			if now.Sub(v.gap) < 150*time.Millisecond && len(v.pending) < 4096 {
+				break
+			}
+			// Give up on this reference chain, never feed a broken access unit
+			// (or dependent P frames) to a decoder and let it smear the picture.
+			nearest := uint16(32767)
+			for seq := range v.pending {
+				if d := seq - v.next; d < nearest {
+					nearest = d
+				}
+			}
+			v.Lost += uint64(nearest)
+			v.next += nearest
+			v.damage()
+			continue
+		}
+		delete(v.pending, v.next)
+		v.next++
+		v.ordered(packet)
+	}
+	if len(v.pending) == 0 {
+		v.gap = time.Time{}
+	}
+	v.requestKey(now)
+}
+
+func (v *videoRepair) ordered(p *rtp.Packet) {
+	// Empty RTP padding still consumes a sequence number.
+	if len(p.Payload) == 0 {
+		return
+	}
+	if !v.boundary {
+		if p.Marker {
+			v.boundary = true
+		}
+		return
+	}
+	if len(v.frame) != 0 && p.Timestamp != v.stamp {
+		// Missing marker or malformed access unit. Sync to the next boundary.
+		v.damage()
+		if p.Marker {
+			v.boundary = true
+		}
+		return
+	}
+	if len(v.frame) == 0 {
+		v.stamp = p.Timestamp
+	}
+	v.frame = append(v.frame, p)
+	v.bytes += len(p.Payload)
+	v.key = v.key || repairKeyPacket(p.Payload, v.hevc)
+	if v.bytes > 8*1024*1024 || len(v.frame) > 8192 {
+		v.damage()
+		if p.Marker {
+			v.boundary = true
+		}
+		return
+	}
+	if !p.Marker {
+		return
+	}
+	if !v.needKey || v.key {
+		v.needKey = false
+		for _, packet := range v.frame {
+			// RTSP has its own sequence space: intentional frame/padding drops
+			// must not look like fresh network loss to the local decoder.
+			if !v.outStarted {
+				v.outNext = packet.SequenceNumber
+				v.outStarted = true
+			}
+			clone := *packet
+			clone.SequenceNumber = v.outNext
+			v.outNext++
+			v.emit(&clone)
+		}
+		v.Frames++
+	} else {
+		v.Suppressed++
+	}
+	v.frame = nil
+	v.bytes = 0
+	v.key = false
+}
+
+func repairKeyPacket(b []byte, hevc bool) bool {
+	if hevc {
+		if len(b) < 2 {
+			return false
+		}
+		t := (b[0] >> 1) & 63
+		if t == 49 && len(b) >= 3 && b[2]&128 != 0 {
+			t = b[2] & 63
+		}
+		// IDR/BLA reset all references. CRA may have leading RASL pictures.
+		if t >= 16 && t <= 20 {
+			return true
+		}
+		if t == 48 {
+			return repairAggregateKey(b[2:], true)
+		}
+		return false
+	}
+	if len(b) == 0 {
+		return false
+	}
+	t := b[0] & 31
+	if t == 5 {
+		return true
+	}
+	if t == 28 {
+		return len(b) >= 2 && b[1]&128 != 0 && b[1]&31 == 5
+	}
+	if t == 24 {
+		return repairAggregateKey(b[1:], false)
+	}
+	return false
+}
+
+func repairAggregateKey(b []byte, hevc bool) bool {
+	key := false
+	for len(b) >= 2 {
+		n := int(b[0])<<8 | int(b[1])
+		b = b[2:]
+		if n == 0 || n > len(b) {
+			return false
+		}
+		// Only single NAL units belong in an aggregation packet.
+		if hevc {
+			t := (b[0] >> 1) & 63
+			key = key || (n >= 2 && t >= 16 && t <= 20)
+		} else {
+			key = key || b[0]&31 == 5
+		}
+		b = b[n:]
+	}
+	return key && len(b) == 0
+}
