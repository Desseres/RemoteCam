@@ -0,0 +1,85 @@
+package webrtc
+
+import (
+	"testing"
+	"time"
+
+	"github.com/pion/rtp"
+	"github.com/stretchr/testify/require"
+)
+
+func repairPacket(seq uint16, ts uint32, mark bool, b ...byte) *rtp.Packet {
+	return &rtp.Packet{Header: rtp.Header{SequenceNumber: seq, Timestamp: ts, Marker: mark}, Payload: b}
+}
+
+func TestVideoRepairReordersWrapAndIgnoresDuplicates(t *testing.T) {
+	var got []*rtp.Packet
+	now := time.Unix(10, 0)
+	v := newVideoRepair(false, func(p *rtp.Packet) { got = append(got, p) }, func() {})
+	v.Push(repairPacket(65533, 1, true, 0x41), now) // establish frame boundary
+	v.Push(repairPacket(65534, 2, false, 0x7c, 0x85, 1), now)
+	v.Push(repairPacket(0, 2, true, 0x7c, 0x45, 3), now.Add(5*time.Millisecond))
+	require.Empty(t, got) // never expose a partial keyframe
+	v.Push(repairPacket(65535, 2, false, 0x7c, 0x05, 2), now.Add(30*time.Millisecond))
+	require.Len(t, got, 3)
+	require.Equal(t, []uint16{65534, 65535, 0}, []uint16{got[0].SequenceNumber, got[1].SequenceNumber, got[2].SequenceNumber})
+	v.Push(repairPacket(65535, 2, false, 0x7c, 0x05), now.Add(40*time.Millisecond))
+	require.Len(t, got, 3)
+	require.Zero(t, v.Lost)
+}
+
+func TestVideoRepairLossRequiresNewIDR(t *testing.T) {
+	var got []*rtp.Packet
+	requests := 0
+	now := time.Unix(10, 0)
+	v := newVideoRepair(false, func(p *rtp.Packet) { got = append(got, p) }, func() { requests++ })
+	v.Push(repairPacket(0, 0, true, 0x41), now)
+	v.Push(repairPacket(1, 1, true, 0x65), now)
+	v.Push(repairPacket(2, 2, false, 0x7c, 0x81), now)
+	// seq 3 never arrives. Neither its damaged frame nor following P frames
+	// may poison the decoder's reference pictures.
+	v.Push(repairPacket(4, 2, true, 0x7c, 0x41), now)
+	v.Push(repairPacket(5, 3, true, 0x41), now.Add(160*time.Millisecond))
+	v.Push(repairPacket(6, 4, true, 0x41), now.Add(600*time.Millisecond))
+	require.Len(t, got, 1)
+	require.Equal(t, uint64(1), v.Lost)
+	require.Equal(t, 2, requests)
+	v.Push(repairPacket(7, 5, true, 0x65), now.Add(700*time.Millisecond))
+	v.Push(repairPacket(8, 6, true, 0x41), now.Add(710*time.Millisecond))
+	require.Len(t, got, 3)
+	require.False(t, v.needKey)
+}
+
+func TestVideoRepairPaddingAndMissingMarker(t *testing.T) {
+	var got []*rtp.Packet
+	now := time.Unix(10, 0)
+	v := newVideoRepair(false, func(p *rtp.Packet) { got = append(got, p) }, func() {})
+	v.Push(repairPacket(0, 0, true, 0x41), now)
+	v.Push(repairPacket(1, 1, false, 0x7c, 0x85), now)
+	v.Push(repairPacket(2, 1, false), now)
+	v.Push(repairPacket(3, 1, true, 0x7c, 0x45), now)
+	require.Len(t, got, 2)
+	v.Push(repairPacket(4, 2, false, 0x41), now)
+	v.Push(repairPacket(5, 3, true, 0x41), now)
+	v.Push(repairPacket(6, 4, true, 0x41), now)
+	require.Len(t, got, 2)
+	require.True(t, v.needKey)
+}
+
+func TestVideoRepairHEVCAndBounds(t *testing.T) {
+	var got []*rtp.Packet
+	now := time.Unix(10, 0)
+	v := newVideoRepair(true, func(p *rtp.Packet) { got = append(got, p) }, func() {})
+	v.Push(repairPacket(0, 0, true, 2, 1), now)
+	v.Push(repairPacket(1, 1, false, 98, 1, 128|19), now)
+	v.Push(repairPacket(2, 1, true, 98, 1, 64|19), now)
+	require.Len(t, got, 2)
+	for seq := uint16(4); seq < 4200; seq++ {
+		v.Push(repairPacket(seq, 2, false, 2, 1), now)
+	}
+	require.Less(t, len(v.pending), 4096)
+	require.LessOrEqual(t, len(v.frame), 8192)
+	require.True(t, v.needKey)
+	require.True(t, repairKeyPacket([]byte{48 << 1, 1, 0, 2, 19 << 1, 1}, true))
+	require.False(t, repairKeyPacket([]byte{48 << 1, 1, 0, 20, 19 << 1, 1}, true))
+}
